APP_HOST=0.0.0.0
APP_PORT=7860
MAX_UPLOAD_MB=25
APP_PROJECT_ROOT=/app

# Canonical runtime layout. All generated application state lives under /app/var.
VAR_DIR=/app/var
UPLOAD_DIR=/app/var/uploads
RESULTS_DIR=/app/var/jobs
REPORTS_DIR=/app/var/reports
LOGS_DIR=/app/var/logs

# Ollama runs on the Windows host / laptop while the app runs in Docker.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4
OLLAMA_KEEP_ALIVE=
NUM_CTX=24384
NUM_PREDICT=8192
LLM_TIMEOUT_SECONDS=300
MAX_LINES_FOR_LLM=220
# Extraction strategy: current or spatial_overview.
EXTRACTION_STRATEGY=spatial_overview
SPATIAL_OVERVIEW_NUM_CTX=16384
SPATIAL_OVERVIEW_NUM_PREDICT=4096
SPATIAL_OVERVIEW_TIMEOUT_SECONDS=180
SPATIAL_CANVAS_WIDTH=112
LLM_JSON_RETRY_COUNT=1
OLLAMA_FORMAT_JSON=1

# Stable main-app PaddleOCR settings.
FLAGS_enable_pir_api=0
FLAGS_use_mkldnn=0
FLAGS_use_onednn=0
OCR_ENABLE_MKLDNN=0
OCR_DEVICE=cpu
OCR_LANG=german
OCR_MAX_SIDE_LIMIT=4000
OCR_DET_LIMIT_SIDE_LEN=4000
OCR_USE_ANGLE_CLS=1
OCR_CPU_THREADS=4
VALIDATION_TOLERANCE=0.03
MAX_REOCR_IMAGES=0

# Baseline VLM service settings. CLI/doc_parser is the default runner.
VLM_ENABLED=1
VLM_BACKEND=http_service
VLM_SERVICE_URL=http://receipt-vlm:7870
VLM_CORRECTION_ENABLED=1
VLM_TIMEOUT_SECONDS=900
VLM_SERVICE_REQUEST_TIMEOUT_SECONDS=900
VLM_SERVICE_MAX_SIDE_LIMIT=1200
# Path-list separator is ":" in Linux containers and ";" on Windows.
VLM_ALLOWED_INPUT_ROOTS=/app/var
VLM_SERVICE_RUNNER=cli
VLM_ENGINE=transformers
VLM_DEVICE=gpu:0
VLM_ALLOW_CPU_FALLBACK=0
CUDA_VISIBLE_DEVICES=0
PADDLE_DEVICE=gpu:0

# No automatic Ollama/GPU handoff in the baseline.
VLM_GPU_ORCHESTRATION=none
OLLAMA_UNLOAD_BEFORE_VLM=0
OLLAMA_RELOAD_AFTER_VLM=0
OLLAMA_CONTROL_MODE=api
OLLAMA_CONTROL_TIMEOUT_SECONDS=120
OLLAMA_UNLOAD_COMMAND=
OLLAMA_START_COMMAND=
OLLAMA_RELOAD_PROMPT=ok
OLLAMA_GPU_HANDOFF_WAIT_SECONDS=0

# Persistent model caches mounted from the shared folder two levels above this project.
# Override this if your cache is somewhere else, for example: C:/Users/<you>/model_cache
MODEL_CACHE_ROOT=../../model_cache
PADDLEX_HOME=/root/.paddlex
HF_HOME=/root/.cache/huggingface
TRANSFORMERS_CACHE=/root/.cache/huggingface
TORCH_HOME=/root/.cache/torch
PADDLE_HOME=/root/.cache/paddle

# Batch folder execution.
BATCH_INPUT_DIR=/app/var/batch_input
BATCH_MAX_FILES=250
BATCH_RECURSIVE_DEFAULT=0
BATCH_ALLOW_ANY_PATH=0

# Bounded process-level background execution. Keep one worker when OCR/VLM/LLM
# share local CPU/GPU resources. Persisted queued/running jobs are recovered.
JOB_WORKER_MAX_WORKERS=1
JOB_QUEUE_CAPACITY=32
JOB_CLAIM_LEASE_SECONDS=120
JOB_MAINTENANCE_INTERVAL_SECONDS=10
JOB_RECOVER_PENDING=1

# V14.14 item categorization.
CATEGORIZATION_ENABLED=1
CATEGORIZATION_MODEL=gemma4
CATEGORIZATION_NUM_CTX=8192
CATEGORIZATION_NUM_PREDICT=4096
CATEGORIZATION_TIMEOUT_SECONDS=180
CATEGORIZATION_FORMAT_JSON=1

# Phase 2 receipt intelligence database.
DATA_DIR=/app/var/database
RECEIPT_DB_PATH=/app/var/database/receipt_intelligence.db

# Phase 2 schema-constrained Query Planner.
# Ask Your Receipts strategy selection. RAG-SQL is the application default;
# Phase 7 observability and readiness
QUERY_TELEMETRY_ENABLED=1
QUERY_TELEMETRY_PATH=/app/var/logs/query_events.jsonl
READINESS_PROBE_OLLAMA=1
READINESS_PROBE_VLM=1
READINESS_REQUIRE_OLLAMA=0
READINESS_REQUIRE_VLM=0
READINESS_TIMEOUT_SECONDS=2

# RAG item embeddings (derived index; generated with scripts/rebuild_rag_item_index.py)
RAG_EMBEDDING_ENABLED=1
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=120
RAG_EMBEDDING_KEEP_ALIVE=30m
# Leave blank until a threshold is measured on your own retrieval corpus.
RAG_RETRIEVAL_MINIMUM_SCORE=
RAG_RETRIEVAL_DEFAULT_LIMIT=10
RAG_RETRIEVAL_MAX_LIMIT=100
RAG_RETRIEVAL_RRF_K=60
RAG_RETRIEVAL_VECTOR_WEIGHT=1.0
RAG_RETRIEVAL_LEXICAL_WEIGHT=1.5
RAG_RETRIEVAL_DEDUPLICATE=1
RAG_CANDIDATE_RESOLVER_ENABLED=1
RAG_CANDIDATE_MODEL=gemma4
RAG_CANDIDATE_MAX_CANDIDATES=12
RAG_CANDIDATE_NUM_CTX=6144
RAG_CANDIDATE_NUM_PREDICT=1536
RAG_CANDIDATE_TIMEOUT_SECONDS=120
RAG_CANDIDATE_RETRY_COUNT=1
RAG_CANDIDATE_FORMAT_JSON=1
RAG_CANDIDATE_KEEP_ALIVE=

# RAG-assisted SQL engine with LangGraph orchestration.
RAG_SQL_ENABLED=1
RAG_SQL_ANALYZER_MODEL=gemma4
RAG_SQL_ANALYZER_NUM_CTX=6144
RAG_SQL_ANALYZER_NUM_PREDICT=768
RAG_SQL_ANALYZER_TIMEOUT_SECONDS=120
RAG_SQL_ANALYZER_RETRY_COUNT=1
RAG_SQL_PLANNER_MODEL=gemma4
RAG_SQL_PLANNER_NUM_CTX=6144
RAG_SQL_PLANNER_NUM_PREDICT=2048
RAG_SQL_PLANNER_TIMEOUT_SECONDS=120
RAG_SQL_PLANNER_RETRY_COUNT=1
# Hybrid answer formatting runs only when deterministic extraction finds
# reviewed evidence but cannot safely normalize the answer.
RAG_SQL_ANSWER_FORMATTER_ENABLED=1
RAG_SQL_ANSWER_FORMATTER_MODEL=gemma4
RAG_SQL_ANSWER_FORMATTER_NUM_PREDICT=768
RAG_SQL_ANSWER_FORMATTER_TIMEOUT_SECONDS=120
RAG_SQL_ANSWER_FORMATTER_RETRY_COUNT=1
RAG_SQL_FORMAT_JSON=1
# Shared RAG-SQL residency settings. These are used by question analysis,
# candidate resolution, SQL planning, and bounded answer formatting so Ollama can reuse one Gemma runner.
RAG_SQL_LLM_KEEP_ALIVE=30m
RAG_SQL_LLM_NUM_CTX=6144
# Backwards-compatible alias; leave blank when using RAG_SQL_LLM_KEEP_ALIVE.
RAG_SQL_KEEP_ALIVE=
RAG_SQL_MAX_ENTITIES=4
RAG_SQL_RETRIEVAL_LIMIT=12
RAG_SQL_MAX_ROWS=100
RAG_SQL_EXECUTION_TIMEOUT_SECONDS=5
RAG_SQL_VALIDATION_REPAIR_COUNT=1
RAG_SQL_GRAPH_RECURSION_LIMIT=50

# Persist provider-neutral model-call token/timing metrics in SQLite.
MODEL_CALL_TELEMETRY_ENABLED=1

# Runtime/dependency image for the receipt web app.
# Build this only when requirements/app.txt or system packages change.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FLAGS_enable_pir_api=0 \
    FLAGS_use_mkldnn=0 \
    FLAGS_use_onednn=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/app.txt /tmp/requirements-app.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements-app.txt

RUN mkdir -p /app/var/uploads /app/var/jobs /app/var/database /app/var/reports /app/var/batch_input /app/var/logs

EXPOSE 7860
CMD ["python", "app.py"]

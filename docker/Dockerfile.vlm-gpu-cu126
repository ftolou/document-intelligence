# Deprecated compatibility entrypoint.
# Use the long-term split instead:
#   docker/Dockerfile.vlm-runtime-cu126  -> heavy CUDA/Paddle/PaddleOCR dependencies
#   docker/Dockerfile.vlm-app            -> thin service code image
#
# This file builds the thin app image and expects receipt-vlm-runtime:cu126 to exist locally.
ARG VLM_RUNTIME_IMAGE=receipt-vlm-runtime:cu126
FROM ${VLM_RUNTIME_IMAGE}

WORKDIR /app
COPY vlm_service.py /app/vlm_service.py
COPY vl_engine.py /app/vl_engine.py
COPY VERSION /app/VERSION
RUN mkdir -p /app/var/uploads /app/var/jobs /app/var/database /app/var/reports /app/var/batch_input /app/var/logs
EXPOSE 7870
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -fsS http://localhost:7870/health || exit 1
CMD ["python", "vlm_service.py"]
